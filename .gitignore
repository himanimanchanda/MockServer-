# ══════════════════════════════════════════════════════
# Mock Server — .gitignore
# ══════════════════════════════════════════════════════

# ── IDEs ──────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ── Maven (Backend) ───────────────────────────────────
mock-server-backend/target/
mock-server-backend/*.jar
mock-server-backend/*.war
mock-server-backend/.mvn/wrapper/maven-wrapper.jar

# ── Node.js (Frontend) ────────────────────────────────
mock-server-frontend/node_modules/
mock-server-frontend/dist/
mock-server-frontend/build/
mock-server-frontend/.next/
mock-server-frontend/.env.local
mock-server-frontend/.env.development.local
mock-server-frontend/.env.test.local
mock-server-frontend/.env.production.local

# ── Runtime Logs ──────────────────────────────────────
logs/
*.log

# ── OS Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Docker volumes / data ─────────────────────────────
postgres_data/
redis_data/
